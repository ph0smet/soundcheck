{
  "schema_version": 2,
  "kind": "kubernetes-rbac-access",
  "context": {
    "schema_version": 1,
    "snapshot_complete": true,
    "identities": [
      {
        "username": "system:serviceaccount:frontend:frontend-sa",
        "groups": [
          "system:authenticated",
          "system:serviceaccounts",
          "system:serviceaccounts:frontend"
