(test
 (name rbac_repair_bench_t)
 (modules rbac_repair_bench_t)
 (libraries soundcheck_rbac_repair_bench soundcheck_pilot soundcheck_core soundcheck_kubernetes_rbac unix))

(executable
 (name rbac_repair_cli_t)
 (modules rbac_repair_cli_t)
 (libraries soundcheck_core soundcheck_kubernetes_rbac unix))

(rule
 (alias runtest)
 (deps (source_tree rbac-examples)
       (source_tree ../kubernetes-rbac/fixtures)
       ../kubernetes-rbac/contracts/frontend-access.json)
 (action
  (run %{exe:rbac_repair_cli_t.exe} %{exe:rbac_main.exe} rbac-examples ../kubernetes-rbac)))

