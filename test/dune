; Harness lifecycle checks use mocked commands; real Docker remains a separate
; conformance job and is never invoked by this runtest rule.
(rule
 (alias runtest)
 (deps
  kong_conformance_harness_t.sh
  fixtures/kong_conformance/mock-command.sh
  ../bench/kong/conformance/run.sh
  ../bench/kong/conformance/kong.yaml
  ../bench/kong/conformance/probes.tsv
  ../bench/kong/conformance/auth.yaml
  ../bench/kong/conformance/auth-probes.tsv
  ../bench/kong/conformance/paths.yaml
  ../bench/kong/conformance/paths-probes.tsv
  ../bench/kong/conformance/mixed.yaml
  ../bench/kong/conformance/mixed-probes.tsv
  ../bench/kong/conformance/reducer.yaml
  ../bench/kong/conformance/reducer-probes.tsv
  ../bench/kong/conformance/category.yaml
  ../bench/kong/conformance/category-probes.tsv
  ../bench/kong/conformance/hosts.yaml
  ../bench/kong/conformance/hosts-probes.tsv
  ../bench/kong/conformance/boundaries.yaml
  ../bench/kong/conformance/boundaries-probes.tsv
  ../bench/kong/conformance/ip.yaml
  ../bench/kong/conformance/ip-probes.tsv
  ../bench/kong/conformance/termination.yaml
  ../bench/kong/conformance/termination-probes.tsv
  ../bench/kong/conformance/oss-auth.yaml
  ../bench/kong/conformance/oss-auth-probes.tsv)
 (action
  (run
   bash
   %{dep:kong_conformance_harness_t.sh}
   %{dep:../bench/kong/conformance/run.sh}
   %{dep:fixtures/kong_conformance/mock-command.sh})))

