# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Proof-or-counterexample verification for declarative security policy"
description:
  "Soundcheck proves security invariants over declarative policy artifacts such as API-gateway configurations, returning either a machine-checkable proof that no violating request exists or a concrete counterexample expressed in the config's own vocabulary. Policy is lowered to a shared decision IR, encoded to SMT-LIB2 alongside the negated property, and discharged with Z3."
maintainer: ["Sourav Kumar"]
authors: ["Sourav Kumar"]
license: "MIT"
homepage: "https://github.com/ph0smet/soundcheck"
bug-reports: "https://github.com/ph0smet/soundcheck/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.11"}
  "yaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ph0smet/soundcheck.git"
